{
  "name": "@tanaab/emori",
  "description": "EMORI, co-founder as agent.",
  "version": "1.0.0-beta.13",
  "author": "EMORI @emoriwan",
  "license": "MIT",
  "repository": "https://github.com/tanaabased/emori",
  "bugs": "https://github.com/tanaabased/emori/issues",
  "homepage": "https://github.com/tanaabased/emori",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <1.5.0",
    "node": ">=24.22.1 <25.0.0 || >=26.12.1 <27.0.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "2.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "openclaw": "2026.10.6",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "leia": "bun ./node_modules/.bin/leia",
    "lint": "bun run lint:eslint && bun run lint:examples && bun run lint:skills && bun run format:check",
    "lint:eslint": "bun run --bun eslint .",
    "test": "bun run test:unit",
    "test:unit": "bun --bun mocha \"skills/*/test/**/*.spec.js\" \"lib/*/test/*.spec.js\"",
    "lint:examples": "bun scripts/validate-examples-task.js",
    "validate": "bun run lint && bun run test",
    "lint:skills": "bun scripts/validate-skills-task.js"
  },
  "dependencies": {
    "@lickle/lock": "0.0.1"
  }
}
