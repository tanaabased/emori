    "bun": ">=1.4.2 <1.5.0",
    "node": ">=24.15.0 <25.0.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "2.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "openclaw": "2026.9.6",
    "prettier": "^3.9.8"
  },
  "scripts": {
    "format:check": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "leia": "bun ./node_modules/.bin/leia",
    "lint": "bun run lint:eslint && bun run format:check",
    "lint:eslint": "eslint .",
    "test": "bun run test:unit",
